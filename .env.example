# ============================================
# QuickShare — Environment Configuration
# ============================================

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Database (sqlite | postgres | mysql | mongodb)
DB_TYPE=sqlite
# DB_SQLITE_PATH=/app/data/quickshare.db

# PostgreSQL / MySQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=quickshare
# DB_USER=quickshare
# DB_PASSWORD=your_secure_password

# MongoDB
# DB_MONGO_URI=mongodb://localhost:27017/quickshare

# Admin (created via UI on first setup)
JWT_SECRET=change-me-to-random-string-in-production

# SSL/TLS
# SSL_CERT=/app/certs/cert.pem
# SSL_KEY=/app/certs/key.pem

# Network
CORS_ORIGIN=*

# Let's Encrypt (for production with domain)
# DOMAIN=your-domain.com
# EMAIL=admin@your-domain.com
