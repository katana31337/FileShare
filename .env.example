# ============================================
# QuickShare — Environment Configuration
# ============================================

# Frontend (Nginx)
PORT=80

# Backend (Node.js)
BACKEND_PORT=3001
NODE_ENV=production

# Database (sqlite | postgres | mysql | mongodb)
DB_TYPE=postgres

# PostgreSQL (default)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=quickshare
DB_USER=quickshare
DB_PASSWORD=your_secure_password

# SQLite (alternative)
# DB_TYPE=sqlite
# DB_SQLITE_PATH=/app/data/quickshare.db

# MySQL (alternative)
# DB_TYPE=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=quickshare
# DB_USER=quickshare
# DB_PASSWORD=your_secure_password

# MongoDB (alternative)
# DB_TYPE=mongodb
# DB_MONGO_URI=mongodb://mongo:27017/quickshare

# Security
JWT_SECRET=change-me-to-random-string-in-production

# SSL/TLS
# SSL_CERT=/app/certs/cert.pem
# SSL_KEY=/app/certs/key.pem

# Network
CORS_ORIGIN=http://frontend

# Let's Encrypt (for production with domain)
# DOMAIN=your-domain.com
# EMAIL=admin@your-domain.com
