# ============================================
# QuickShare Backend — Node.js + Express
# ============================================

# Stage 1: Build TypeScript
FROM node:20-alpine AS builder
WORKDIR /app

# Build argument to determine if SQLite is needed
ARG USE_SQLITE=false

# Install build dependencies only if SQLite is selected
RUN if [ "$USE_SQLITE" = "true" ]; then \
      apk add --no-cache python3 make g++; \
    fi

COPY server/package.json ./package.json

# Install dependencies (skip better-sqlite3 compilation if not using SQLite)
RUN if [ "$USE_SQLITE" = "true" ]; then \
      npm install --no-audit --no-fund; \
    else \
      npm install --no-audit --no-fund --ignore-scripts; \
    fi

# Copy source files excluding tests
COPY server/src ./src
COPY server/tsconfig.json ./tsconfig.json
RUN npm run build

# Stage 2: Production
FROM node:20-alpine AS production
WORKDIR /app

# Build argument to determine if SQLite is needed
ARG USE_SQLITE=false

# Install build dependencies only if SQLite is selected
RUN if [ "$USE_SQLITE" = "true" ]; then \
      apk add --no-cache python3 make g++; \
    fi

COPY server/package.json ./package.json

# Install production dependencies
RUN if [ "$USE_SQLITE" = "true" ]; then \
      npm install --omit=dev --no-audit --no-fund; \
    else \
      npm install --omit=dev --no-audit --no-fund --ignore-scripts; \
    fi

COPY --from=builder /app/dist ./dist
COPY server/healthcheck.js ./healthcheck.js
RUN mkdir -p /app/data/uploads

# Clean up build dependencies to reduce image size (only if they were installed)
RUN if [ "$USE_SQLITE" = "true" ]; then \
      apk del python3 make g++; \
    fi

ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD node /app/healthcheck.js
CMD ["node", "dist/index.js"]
