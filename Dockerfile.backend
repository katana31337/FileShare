# ============================================
# QuickShare Backend — Node.js + Express
# ============================================

# Stage 1: Build TypeScript
FROM node:20-alpine AS builder
WORKDIR /app
COPY server/package.json ./package.json
RUN npm install --no-audit --no-fund
COPY server/ .
RUN npm run build

# Stage 2: Production
FROM node:20-alpine AS production
WORKDIR /app
COPY server/package.json ./package.json
RUN npm install --omit=dev --no-audit --no-fund
COPY --from=builder /app/dist ./dist
RUN mkdir -p /app/data/uploads /app/certs
COPY server/generate-certs.sh ./generate-certs.sh
RUN chmod +x ./generate-certs.sh
ENV NODE_ENV=production
ENV PORT=3001
ENV HOST=0.0.0.0
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider --no-check-certificate https://localhost:3001/api/health || exit 1
CMD ["node", "dist/index.js"]
